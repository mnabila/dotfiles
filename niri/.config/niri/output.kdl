//     scale 1
//     transform "180"
//     position x=0 y=1080
//     hot-corners {
//         bottom-left
//     }
// }

// External monitor (DP-1) — 60 Hz preferred mode
output "DP-1" {
    mode "1920x1080@60.000"
    scale 1
    hot-corners {
        top-right
    }
}
