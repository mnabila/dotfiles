// Built-in laptop display (eDP-1) — locked to 60 Hz
output "eDP-1" {
    mode "1920x1080@59.997"
    scale 1
    transform "normal"
    position x=0 y=0
    focus-at-startup
    hot-corners {
        top-left
    }
}
// // External monitor (DP-1) — 60 Hz preferred mode
// output "DP-1" {
